generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums

enum ThemeMode {
  AUTO
  LIGHT
  DARK
}

enum UserRole {
  admin
  user
  moderator
}

enum UserStatus {
  pendingapproval
  approved
  suspended
  banned
}

enum Currency {
  INR
  USD
  EUR
}

enum UserDocumentType {
  aadhar_card
  pan_card
  election_card
  other
}

// Better Auth tables

model User {
  id               String     @id @default(cuid())
  name             String
  email            String
  emailVerified    Boolean    @default(false)
  image            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  role             String     @default("user")
  status           UserStatus @default(pendingapproval)
  banned           Boolean?   @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?   @default(false)

  // Custom fields from userinfo
  contactNo   String?
  occupation  String?
  address     String? @db.Text
  description String? @db.Text

  sessions      Session[]
  accounts      Account[]
  twofactors    TwoFactor[]
  passkeys      Passkey[]
  userSettings  UserSettings?
  userDocuments UserDocument[]
  createdPasses Pass[]

  username        String?
  displayUsername String?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(true)

  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// Application settings tables

model UserSettings {
  userId     String    @id
  currency   Currency  @default(INR)
  locale     String    @default("en-IN")
  dateFormat String    @default("dd MMM, yyyy")
  timeFormat String    @default("hh:mm a")
  language   String    @default("en")
  theme      ThemeMode @default(AUTO)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("userSettings")
}

model AppConfig {
  id                  String   @id @default("singleton")
  smtpHost            String?
  smtpPort            Int?     @default(587)
  smtpUser            String?
  smtpPass            String?
  smtpSecure          Boolean? @default(false)
  fromEmail           String?
  googleClientId      String?
  googleClientSecret  String?
  discordClientId     String?
  discordClientSecret String?

  @@map("appConfig")
}

model UserDocument {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName             String
  extension            String
  documentRelativePath String
  documentType         UserDocumentType
  createdBy            String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@map("userDocument")
}

// EventKey Domain Models

enum PassStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELLED
}

enum CheckInStatus {
  APPROVED
  DENIED
}

enum EventStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum RegistrationStatus {
  CONFIRMED
  PENDING
  CANCELLED
}

model Event {
  id                  String              @id @default(cuid())
  title               String
  description         String?             @db.Text
  location            String?
  startDate           DateTime
  endDate             DateTime
  capacity            Int                 @default(100)
  status              EventStatus         @default(ACTIVE)
  registrationId      String?             @unique
  registrationEnabled Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  passes        Pass[]
  checkIns      CheckIn[]
  registrations EventRegistration[]

  @@map("event")
}

model Pass {
  id             String             @id @default(cuid())
  eventId        String
  event          Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token          String             @unique
  holderName     String
  holderEmail    String
  status         PassStatus         @default(ACTIVE)
  createdBy      String?
  creator        User?              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  registrationId String?
  registration   EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  checkIns CheckIn[]

  @@index([eventId])
  @@index([token])
  @@index([createdBy])
  @@index([registrationId])
  @@map("pass")
}

model CheckIn {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  passId          String?
  pass            Pass?         @relation(fields: [passId], references: [id], onDelete: SetNull)
  scannedToken    String
  status          CheckInStatus
  rejectionReason String?
  scannedAt       DateTime      @default(now())
  scannedBy       String?

  @@index([eventId])
  @@index([passId])
  @@map("checkIn")
}

model EventRegistration {
  id           String             @id @default(cuid())
  eventId      String
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  primaryName  String
  mobileNumber String
  place        String
  status       RegistrationStatus @default(CONFIRMED)
  totalMembers Int                @default(1)

  familyMembers RegistrationMember[]
  passes        Pass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([mobileNumber])
  @@map("eventRegistration")
}

model RegistrationMember {
  id             String            @id @default(cuid())
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  relation       String // Father, Mother, Husband, Wife, Son, Daughter, Brother, Sister, Other

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@map("registrationMember")
}
